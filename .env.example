# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1
SERVER_URL=http://localhost:5000

# Swagger/OpenAPI Documentation
# In development/staging, docs are public for easier testing.
# In production, docs are still available but require admin Bearer token.
SWAGGER_DOCS_PATH=/api/docs
SWAGGER_DOCS_JSON_PATH=/api/docs.json

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/sinux-boilerplate
MONGODB_URI_TEST=mongodb://localhost:27017/sinux-boilerplate-test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key
JWT_REFRESH_EXPIRE=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# For multiple origins, separate by commas:
# CORS_ORIGIN=http://localhost:3000,https://app.eventforge.com

# OAuth (for frontend NextAuth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# One-time admin seed credentials
ADMIN_SEED_NAME=Platform Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe123

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Cursor SDK (https://cursor.com/docs/sdk/typescript)
# User or team service-account key from Cursor Dashboard → Integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Optional: override local agent working directory (defaults to this repo root)
# CURSOR_WORKSPACE_CWD=
# Short tasks with project .cursor rules/skills: npm run cursor:task -- "your task"
# After changes, update tests: npm run cursor:tests -- "optional summary"
# Feature + tests: npm run cursor:task -- --with-tests "your task"
# Full pipeline (feature → tests → commit → PR): npm run cursor:ship -- "your task"
# Skip PR step: npm run cursor:ship -- --no-pr "your task"
# PR base branch (auto-detected from origin/HEAD if unset; this repo uses master):
# CURSOR_PR_BASE_BRANCH=master
# Tests + commit + PR: npm run cursor:commit -- --pr "optional summary"
# Open PR only: npm run cursor:pr -- "optional summary"

# AWS S3 Configuration (Production Only)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sinux-boilerplate-bucket

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Email Alias Configuration (Preferred)
EMAIL_FROM=your-gmail-address@gmail.com
EMAIL_FROM_NAME=EventForge Support
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_WEBSITE_URL=http://localhost:3000
EMAIL_POLICY_URL=http://localhost:3000/policy
EMAIL_HELP_URL=http://localhost:3000/book-demo
EMAIL_APPEAL_URL=http://localhost:3000/book-demo

# SMTP performance tuning
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_SECURE=false

CURSOR_API_KEY=crsr_abc7e90fc781e4ade5a1dc849e5815d76987f717b0335c8a01fdf9780e978ec2
